    <string name="perm_location_title">Location Permission Required</string>
    <string name="perm_location_desc">Starting from Android 8.0, the operating system requires Location permission (ACCESS_FINE_LOCATION) to read the Wi-Fi network name (SSID) and BSSID of the connected router.\n\nNetwork Analyst does NOT track or transmit your actual location.</string>
    <string name="perm_nearby_title">Nearby Devices Permission Required</string>
    <string name="perm_nearby_desc">On Android 13+, the Nearby Wi-Fi Devices permission (NEARBY_WIFI_DEVICES) allows discovering and displaying local devices via mDNS/multicast protocols.</string>
    <string name="perm_phone_state_title">Phone &amp; SIM Status Permission Required</string>
    <string name="perm_phone_state_desc">The Phone State permission (READ_PHONE_STATE) allows reading active SIM card details (carrier, SIM slot, roaming status) and cellular network generation (4G/5G). The app only inspects technical network parameters, without accessing contacts or phone calls.</string>
